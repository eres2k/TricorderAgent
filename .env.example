# ============================================================================
# Tricorder Agent — configuration
# ----------------------------------------------------------------------------
# Everything here has a working default. You can run `node server.js` with no
# .env at all; the first-run guide in the browser will find your model server.
#
# To use this file:   cp .env.example .env    then edit and restart.
#
# Or skip it: `npm run setup` detects what you have, sizes the model to your
# machine, proves the backend can actually call a tool, and fills this file in
# for you. It merges — the comments and anything you have already set survive.
# ============================================================================


# ── The model ───────────────────────────────────────────────────────────────

# Where your OpenAI-compatible model server lives. Point at the server ROOT,
# with no /v1 suffix.
#   LM Studio   http://127.0.0.1:1234     (default)
#   llama.cpp   http://127.0.0.1:8080     (start with --jinja for tool calling)
#   Ollama      http://127.0.0.1:11434
# Setting this counts as "setup done" and skips the first-run guide.
#LLM_BASE_URL=http://127.0.0.1:1234

# Which model to use for the server's own calls (scheduled tasks, background
# agents, /api/ai/*). "auto" uses the first model the backend reports as
# loaded, which is what you want on a single-model setup.
#
#   Target: qwen3.8-27b — native tool calling, 256K context, vision, and
#   reasoning depth that is steerable per request. Q4_K_M is ~16 GB, so it
#   wants roughly 20 GB of VRAM or unified memory.
#
# Careful with "auto" when an embedding model is loaded alongside the chat
# model: whichever the backend lists first wins, and landing on the embedding
# model looks exactly like a broken install. Pin the id when in doubt.
#LLM_MODEL=auto

# A vision-capable model id, if your chat model is text-only. Image turns are
# routed here instead. Leave empty to use LLM_MODEL for everything.
# Qwen3.8-27B is natively multimodal, so on the recommended setup this stays
# empty on purpose — you only need it for a text-only chat model.
#LLM_VISION_MODEL=

# Bearer token, if your backend requires one. Injected server-side; the browser
# never sees it.
#LLM_API_KEY=

# How long a non-streaming server-side generation may take, in milliseconds.
# Raise it on slower hardware — a long reasoning turn sends nothing until it
# is finished, so a low value looks like a dead connection. A 27B model
# thinking at full depth routinely outlives the 120s default; `npm run setup`
# writes 600000 for exactly that reason.
#LLM_TIMEOUT_MS=120000

# OpenAI-compatible /v1/embeddings host used to rank memory by relevance.
# Defaults to the chat backend. Without an embedding model loaded, ranking
# falls back to BM25, which works fine — this is an optimisation, not a
# requirement.
#EMBEDDING_URL=http://127.0.0.1:1234
#EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b


# ── The server ──────────────────────────────────────────────────────────────

#PORT=3000

# Password for the whole site: the app, the model proxy, and /preview/*.
# EMPTY MEANS NO LOGIN. That is fine on a laptop you are the only user of.
# Set it before you point a domain, a tunnel, or a phone on public Wi-Fi at
# this server — the agent can read your files and run commands.
#SITE_PW=

# Public HTTPS origin, when you put this behind a tunnel or reverse proxy.
# Used to build shareable links for dev_server previews.
#PUBLIC_URL=https://agent.example.com

# DEBUG | INFO | WARN | ERROR
#LOG_LEVEL=INFO


# ── Tools ───────────────────────────────────────────────────────────────────

# Where file tools read and write. Created on first start, with code/, data/,
# downloads/ and scratch/ inside it. Paths outside the allowed roots are
# refused regardless of what the model asks for.
#TRICORDER_WORKSPACE=~/tricorder-agent-workspace

# The shell. run_command and /api/exec spawn processes as the user running
# this server — that is the point of a local agent, and it is also the
# sharpest edge in the project. Set to false to remove the capability.
#SHELL_ENABLED=true

# code_exec runs snippets in a throwaway, network-isolated Docker container.
# Needs Docker on the host; without it the tool reports that clearly rather
# than failing mysteriously, so leaving this on is safe.
#CODE_EXEC_ENABLED=true
#CODE_EXEC_IMAGE_PYTHON=python:3.12-slim
#CODE_EXEC_IMAGE_NODE=node:20-slim
#CODE_EXEC_IMAGE_BASH=alpine:3.20

# Browser automation drives a headless Chrome/Chromium over the DevTools
# protocol. The binary is auto-detected; set a path if yours is somewhere
# unusual, or point BROWSER_CDP_URL at a remote Chrome instead. Needs Node 21+.
#CHROMIUM_PATH=
#BROWSER_CDP_URL=
#BROWSER_DEBUG_PORT=9222

# Python interpreter for the few tools that shell out to it (code_linter).
#TRICORDER_PYTHON=python3

# Per-tool-call watchdog and how many tool calls may run at once.
#TOOL_TIMEOUT_MS=120000
#TOOL_MAX_PARALLEL=4


# ── Memory ──────────────────────────────────────────────────────────────────

# Local hour (0-23) at which the agent reviews recent conversations and
# distils durable facts into memory.
#CHATLOG_REVIEW_HOUR=5

# How many distilled insights to keep before the oldest are consolidated away.
#TRICORDER_INSIGHT_CAP=25
